# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel: Set this in Project Settings > Environment Variables.
# Server-side only: never exposed to browser bundles.
GEMINI_API_KEY=

# GOOGLE_SHEETS_WEBHOOK_URL: Required for persistent external storage on Vercel/serverless.
# Webhook URL from Google Apps Script Web App (or Zapier/Make) that receives submissions & interviews.
# When set, every lead, brief, candidate application, and interview schedule is synced directly to your Google Sheet.
# In local development without this key, the server falls back to data/db.json.
GOOGLE_SHEETS_WEBHOOK_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=
